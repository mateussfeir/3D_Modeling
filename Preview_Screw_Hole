import bpy
import math
from mathutils import Vector

# =========================================================
# KEYHOLE SCREW PREVIEW — NO CUTTING
#
# External face:
#   Top = 4 mm
#   Bottom = 8 mm
#
# Hidden internal cavity:
#   Top = 8 mm
#   Bottom = 8 mm
# =========================================================

PREVIEW_PARENT = "KEYHOLE_PREVIEW"

HORIZONTAL_SPACING = 0.08    # 8 mm between keyholes
VERTICAL_SPACING = 0.008      # 8 mm between top/bottom centres

EXTERNAL_TOP_DIAMETER = 0.004
EXTERNAL_BOTTOM_DIAMETER = 0.008

INTERNAL_TOP_DIAMETER = 0.008
INTERNAL_BOTTOM_DIAMETER = 0.008

# Depth into the flat rear face
EXTERNAL_DEPTH = 0.002        # first 2 mm
INTERNAL_DEPTH = 0.004        # additional hidden 4 mm

car = bpy.context.active_object

if car is None or car.type != "MESH":
    raise Exception("Select the CAR mesh before running this code.")

if (
    car.name.startswith("SCREW_")
    or car.name.startswith("KEYHOLE_")
):
    raise Exception("Select the car, not a preview object.")

if bpy.context.mode != "OBJECT":
    bpy.ops.object.mode_set(mode="OBJECT")

# ---------------------------------------------------------
# Remove previous previews
# ---------------------------------------------------------

for obj in list(bpy.data.objects):
    if (
        obj.name.startswith("KEYHOLE_")
        or obj.name.startswith("SCREW_")
    ):
        bpy.data.objects.remove(obj, do_unlink=True)

# ---------------------------------------------------------
# Calculate car bounds in world space
# ---------------------------------------------------------

corners = [
    car.matrix_world @ Vector(corner)
    for corner in car.bound_box
]

min_x = min(p.x for p in corners)
max_x = max(p.x for p in corners)

min_y = min(p.y for p in corners)
max_y = max(p.y for p in corners)

min_z = min(p.z for p in corners)
max_z = max(p.z for p in corners)

car_width = max_y - min_y
car_height = max_z - min_z

center_y = (min_y + max_y) / 2

# Flat cut face
surface_x = min_x

# Initial position: upper portion of the flat surface
keyhole_center_z = min_z + car_height * 0.72

# Keep the holes inside the car
safe_horizontal_spacing = min(
    HORIZONTAL_SPACING,
    max(car_width - 0.020, 0.020)
)

left_y = center_y - safe_horizontal_spacing / 2
right_y = center_y + safe_horizontal_spacing / 2

top_z = keyhole_center_z + VERTICAL_SPACING / 2
bottom_z = keyhole_center_z - VERTICAL_SPACING / 2

# ---------------------------------------------------------
# Preview controller
# ---------------------------------------------------------

bpy.ops.object.empty_add(
    type="PLAIN_AXES",
    location=(surface_x, center_y, keyhole_center_z)
)

controller = bpy.context.active_object
controller.name = PREVIEW_PARENT
controller.show_in_front = True
controller.empty_display_size = 0.010

controller["target_car"] = car.name
controller["horizontal_spacing_mm"] = safe_horizontal_spacing * 1000
controller["vertical_spacing_mm"] = VERTICAL_SPACING * 1000
controller["external_depth_mm"] = EXTERNAL_DEPTH * 1000
controller["internal_depth_mm"] = INTERNAL_DEPTH * 1000

# ---------------------------------------------------------
# Object creation helpers
# ---------------------------------------------------------

def preserve_parent(obj):
    world_matrix = obj.matrix_world.copy()
    obj.parent = controller
    obj.matrix_world = world_matrix


def create_cylinder(name, x, y, z, diameter, depth, display_type):
    bpy.ops.mesh.primitive_cylinder_add(
        vertices=64,
        radius=diameter / 2,
        depth=depth,
        location=(x, y, z),
        rotation=(0, math.radians(90), 0)
    )

    obj = bpy.context.active_object
    obj.name = name
    obj.display_type = display_type
    obj.show_in_front = True

    preserve_parent(obj)

    return obj


def create_connector(
    name,
    x,
    y,
    center_z,
    width,
    height,
    depth,
    display_type
):
    bpy.ops.mesh.primitive_cube_add(
        location=(x, y, center_z)
    )

    obj = bpy.context.active_object
    obj.name = name

    # X = depth into car
    # Y = slot width
    # Z = vertical connection
    obj.dimensions = (
        depth,
        width,
        height
    )

    bpy.ops.object.transform_apply(
        location=False,
        rotation=False,
        scale=True
    )

    obj.display_type = display_type
    obj.show_in_front = True

    preserve_parent(obj)

    return obj

# ---------------------------------------------------------
# Create one complete keyhole
# ---------------------------------------------------------

def create_keyhole(side_name, hole_y):

    # External visible opening
    external_x = surface_x + EXTERNAL_DEPTH / 2

    create_cylinder(
        f"KEYHOLE_{side_name}_EXTERNAL_TOP_4MM",
        external_x,
        hole_y,
        top_z,
        EXTERNAL_TOP_DIAMETER,
        EXTERNAL_DEPTH,
        "SOLID"
    )

    create_cylinder(
        f"KEYHOLE_{side_name}_EXTERNAL_BOTTOM_8MM",
        external_x,
        hole_y,
        bottom_z,
        EXTERNAL_BOTTOM_DIAMETER,
        EXTERNAL_DEPTH,
        "SOLID"
    )

    # 4 mm neck connecting the visible top and bottom
    create_connector(
        f"KEYHOLE_{side_name}_EXTERNAL_NECK_4MM",
        external_x,
        hole_y,
        keyhole_center_z,
        EXTERNAL_TOP_DIAMETER,
        VERTICAL_SPACING,
        EXTERNAL_DEPTH,
        "SOLID"
    )

    # Hidden internal cavity begins behind the external face
    internal_x = (
        surface_x
        + EXTERNAL_DEPTH
        + INTERNAL_DEPTH / 2
    )

    create_cylinder(
        f"KEYHOLE_{side_name}_INTERNAL_TOP_8MM",
        internal_x,
        hole_y,
        top_z,
        INTERNAL_TOP_DIAMETER,
        INTERNAL_DEPTH,
        "WIRE"
    )

    create_cylinder(
        f"KEYHOLE_{side_name}_INTERNAL_BOTTOM_8MM",
        internal_x,
        hole_y,
        bottom_z,
        INTERNAL_BOTTOM_DIAMETER,
        INTERNAL_DEPTH,
        "WIRE"
    )

    # Hidden 8 mm-wide sliding channel
    create_connector(
        f"KEYHOLE_{side_name}_INTERNAL_CHANNEL_8MM",
        internal_x,
        hole_y,
        keyhole_center_z,
        INTERNAL_TOP_DIAMETER,
        VERTICAL_SPACING,
        INTERNAL_DEPTH,
        "WIRE"
    )

# Create left and right keyholes
create_keyhole("LEFT", left_y)
create_keyhole("RIGHT", right_y)

# ---------------------------------------------------------
# Select only the controller
# ---------------------------------------------------------

bpy.ops.object.select_all(action="DESELECT")
controller.select_set(True)
bpy.context.view_layer.objects.active = controller

print("KEYHOLE PREVIEW CREATED")
print("Nothing was cut.")
print("External top: 4 mm")
print("External bottom: 8 mm")
print("Internal top: 8 mm")
print("Internal bottom: 8 mm")
print(f"Horizontal spacing: {safe_horizontal_spacing * 1000:.1f} mm")
print(f"Top/bottom spacing: {VERTICAL_SPACING * 1000:.1f} mm")
print("Move both keyholes with G, then Y or Z.")
